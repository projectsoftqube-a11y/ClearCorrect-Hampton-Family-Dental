# Copy this file to .env.local and fill in the values.
# .env.local is gitignored - never commit real credentials.

# ─── Where this landing page is deployed ───
# Used for canonical tags, Open Graph URLs and JSON-LD @id.
# Set this to the real campaign URL before launch.
# [CONFIRM] The handoff leaves subdomain-vs-path open:
#   "clearcorrect.hamptonfamilydentist.com/ (or /clearcorrect - confirm
#    before build; must match the campaign Final URL)"
# This assumes the subdomain. It drives canonical tags, OG URLs and the
# JSON-LD @id, so it must match the campaign Final URL exactly.
NEXT_PUBLIC_SITE_URL=https://clearcorrect.hamptonfamilydentist.com

# ─── Review annotations ───
# The [CONFIRM] / [DEV] notes from the client review draft render as amber
# notes on the page. Set to false before this takes paid traffic.
NEXT_PUBLIC_LP_REVIEW_NOTES=true

# ─── SMTP for the enquiry form ───
# Mailbox is on Microsoft 365 (Outlook), managed via GoDaddy.
SMTP_HOST=smtp.office365.com
# Microsoft 365 uses 587 with STARTTLS
SMTP_PORT=587
# The mailbox login - the full email address
SMTP_USER=info@hamptonfamilydentist.com
# App Password generated from the Microsoft account. NOT the normal login password.
SMTP_PASS=

# The "from" address shown on the email (often the same as SMTP_USER)
SMTP_FROM=info@hamptonfamilydentist.com
SMTP_FROM_NAME=Hampton Family Dental Website

# Where enquiry submissions are delivered
ENQUIRY_TO=info@hamptonfamilydentist.com

# ─── Fallback storage for leads ───
# A second, independent copy of every submission, so a lead is not lost if the
# primary inbox rejects or silently drops it. Sent as its own message, not a
# Bcc, so a failure on one recipient cannot take the other down. Its subject is
# prefixed "[BACKUP]" so the two copies are distinguishable in the inbox.
#
# This MAY point at the same mailbox as ENQUIRY_TO - that is the current setup,
# and it is intentional: two separate SMTP transactions to info@ mean a silent
# failure on the first still has a second chance to land. The office will
# receive two emails per enquiry.
#
# A genuinely different mailbox (angela@, frontdesk@, or an external address)
# is strictly better redundancy - swap it here, no code change needed.
# Set to an empty value to disable the backup copy entirely.
ENQUIRY_BACKUP_TO=info@hamptonfamilydentist.com
